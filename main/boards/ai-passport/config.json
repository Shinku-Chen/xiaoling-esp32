{
    "target": "esp32c3",
    "builds": [
        {
            "name": "ai-passport",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_USE_ESP_WAKE_WORD=n",
                "CONFIG_DISABLE_STARTUP_SOUND=y",
                "CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8",
                "CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8",
                "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4",
                "CONFIG_ESP_WIFI_RX_BA_WIN=2",
                "CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=8",
                "CONFIG_BT_CTRL_BLE_MAX_ACT=2",
                "CONFIG_BT_ACL_CONNECTIONS=2",
                "CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=10",
                "CONFIG_BT_BLE_42_DTM_TEST_EN=n"
            ]
        }
    ]
}
